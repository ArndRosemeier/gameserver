{
  "name": "gameserver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "How to build multiplayer games on GameHub (games.futuremagic.de): docs, typed client, runnable TS sample.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:lobby": "vite --config vite.lobby.config.ts",
    "build:lobby": "vite build --config vite.lobby.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --experimental-strip-types tests/arena.e2e.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
